# Same anon key as the Angular app (src/environments/environment.ts) —
# RLS policies on `tasks` keep this scoped to whoever logs in via OAuth below.
SUPABASE_URL=https://aenkarrgedrcnqxpakam.supabase.co
SUPABASE_ANON_KEY=

# Public HTTPS base URL this server is reachable at (ngrok tunnel while
# testing, your NAS domain once deployed there). Used as the OAuth issuer —
# must match exactly what the MCP client connects to.
PUBLIC_URL=

PORT=3000

# Only for docker-compose.ngrok.yml: your ngrok authtoken and reserved domain
# (e.g. xxxx.ngrok-free.app). PUBLIC_URL above must then be https://<NGROK_URL>.
NGROK_AUTHTOKEN=
NGROK_URL=
